[Unit]
Description=Riego Inteligente (simulation)
After=network.target
[Service]
Type=simple
User=pi4
WorkingDirectory=/home/pi4/Riego-Inteligente-Por-Zonas
ExecStart=/usr/bin/bash /home/pi4/Riego-Inteligente-Por-Zonas/scripts/run-release.sh
Restart=on-failure
RestartSec=3
Environment=TZ=America/Tijuana
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi4/Riego-Inteligente-Por-Zonas/data
[Install]
WantedBy=multi-user.target
