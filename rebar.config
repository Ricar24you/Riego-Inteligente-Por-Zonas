{erl_opts, [debug_info, warnings_as_errors]}.
{deps, [{cowboy, {git, "https://github.com/ninenines/cowboy.git", {tag, "2.12.0"}}}, {jsx, {git, "https://github.com/talentdeficit/jsx.git", {tag, "v3.1.0"}}}]}.
{overrides, [{override, cowboy, [{deps, [{cowlib, {git, "https://github.com/ninenines/cowlib.git", {tag, "2.13.0"}}}, {ranch, {git, "https://github.com/ninenines/ranch.git", {tag, "1.8.0"}}}]}]}]}.
{shell, [{apps, [riego]}]}.
{relx, [{release, {riego, "0.1.0"}, [riego, sasl]}, {dev_mode, false}, {include_erts, true}, {sys_config, "config/sys.config"}, {vm_args, "config/vm.args"}]}.
